  --color=header:#83a598
  --color=hl+:#fabd2f
  --color=hl:#fabd2f
  --color=info:#928374
  --color=marker:#fb4934
  --color=pointer:#fb4934
  --color=prompt:#83a598
  --color=query:#ebdbb2:regular
  --color=scrollbar:#928374
