font-size = 16
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1

#theme = TokyoNight Moon
theme = Gruvbox Dark Hard
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right

# Fix fast scroll with discrete mouse (default is 3)
mouse-scroll-multiplier = 1

# tmux-resurrect: save (prefix + Ctrl+S)
keybind = cmd+s=text:\x01\x13

# tmux-resurrect: restore (prefix + Ctrl+R)
keybind = cmd+r=text:\x01\x12

# tmux-ressurect: zoom (prefix + z)
keybind = cmd+b=text:\x01\x7a

background-opacity = 0.85
background-blur-radius = 16
macos-titlebar-style = hidden

#padding
window-padding-y = 10
window-padding-x = 10
